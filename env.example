# 複製這份為 .env 供本地測試,正式上線在 Render 的 Environment 分別加入以下變數
# 這份是範例,只放說明文字,不要放真正的密碼或金鑰

# 必填:沒設定的話伺服器會直接停止
MONGODB_URI=你的MongoDB連線字串
JWT_SECRET=一串很長的隨機字串(可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 產生)

# 上傳圖片用
CLOUDINARY_CLOUD_NAME=你的Cloudinary名稱
CLOUDINARY_API_KEY=你的Cloudinary_API_Key
CLOUDINARY_API_SECRET=你的Cloudinary_API_Secret

# 上傳/刪除用的密碼(可留空,留空代表不啟用密碼保護;正式上線請設一組長的)
TEAM_IMAGES_PASSWORD=

PORT=3000
